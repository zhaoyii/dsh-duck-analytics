# Installed dependencies and the pnpm store when it is kept in-tree.
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Test scratch directories created and removed by the suite; ignore leftovers.
test/.tmp-*/

# Local data drops: the analytics data directory is deployment-specific, and the
# sample fixture in data/ is tracked on purpose.
data/*
!data/sales.csv
